{
  "name": "@acme/icon-packs",
  "version": "0.1.0",
  "description": "Semantic icon pack registry with lazy-loaded Vue icon sets",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./legacy": {
      "types": "./src/legacy.ts",
      "import": "./src/legacy.ts"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "vue": "^3.2.0",
    "@acme/theme-engine": "0.1.0"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^1.16.0",
    "@phosphor-icons/vue": "^2.2.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vue": "^3.2.13"
  }
}
